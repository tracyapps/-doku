# Public Discord Application ID, safe to include in the frontend build.
VITE_DISCORD_CLIENT_ID=1548073007950602303
# Server-only settings. Never commit real values.
DISCORD_CLIENT_ID=1548073007950602303
DISCORD_CLIENT_SECRET=
# Neon/Postgres connection string with SSL. Required for Vercel.
DATABASE_URL=
# Public GitHub repository that powers the roadmap and feedback links.
GITHUB_REPO=owner/repository
VITE_GITHUB_REPO=owner/repository
# Optional server-only read token for higher API limits or a private repository.
GITHUB_TOKEN=
# Local API; local persistence defaults to .data/challenges.json.
PORT=3001

# --- Accounts (optional; guest play works without any of this) ---------------
# Public origin players use. Magic links and passkeys are tied to it.
# For phone testing on your LAN use e.g. http://192.168.1.20:5173 (passkeys
# need https, so on plain LAN http only the email link works).
BETTER_AUTH_URL=http://127.0.0.1:5173
# Long random string: `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=
# Extra allowed origins, comma separated (e.g. the Discord Activity proxy).
AUTH_TRUSTED_ORIGINS=
# Email for magic links (resend.com, free tier). Without a key, links are
# printed in the dev:api terminal instead of emailed.
RESEND_API_KEY=
AUTH_EMAIL_FROM=*doku <hello@stardoku.app>
# Sign in with Apple (optional). DISCORD_CLIENT_ID/SECRET above also enable
# "Continue with Discord" — add <BETTER_AUTH_URL>/api/auth/callback/discord
# as a redirect in the Discord Developer Portal.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Comma-separated emails that can see the par check on their profile
# (real solve times vs par, per variant and level).
ADMIN_EMAILS=
