# Public Discord Application ID, safe to include in the frontend build.
VITE_DISCORD_CLIENT_ID=1548073007950602303
# Server-only settings. Never commit real values.
DISCORD_CLIENT_ID=1548073007950602303
DISCORD_CLIENT_SECRET=
# Neon/Postgres connection string with SSL. Required for Vercel.
DATABASE_URL=
# Public GitHub repository that powers the roadmap and feedback links.
GITHUB_REPO=owner/repository
VITE_GITHUB_REPO=owner/repository
# Optional server-only read token for higher API limits or a private repository.
GITHUB_TOKEN=
# Local API; local persistence defaults to .data/challenges.json.
PORT=3001
