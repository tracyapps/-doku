{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "redirects": [
    { "source": "/play", "destination": "/play/", "permanent": true },
    { "source": "/history", "destination": "/history/", "permanent": true },
    { "source": "/roadmap", "destination": "/roadmap/", "permanent": true },
    { "source": "/how", "destination": "/how/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy/", "permanent": true },
    { "source": "/terms", "destination": "/terms/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/web.html" },
    { "source": "/play/", "destination": "/web.html" },
    { "source": "/history/", "destination": "/web.html" },
    { "source": "/roadmap/", "destination": "/web.html" },
    { "source": "/how/", "destination": "/web.html" },
    { "source": "/privacy/", "destination": "/web.html" },
    { "source": "/terms/", "destination": "/web.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
